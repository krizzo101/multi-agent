# LLM API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM Selection
DEFAULT_LLM=openai

# System Prompts
LLM_SYSTEM_PROMPT=You are a helpful AI assistant designed to provide clear, concise, and friendly responses to a wide variety of queries. Be helpful, engaging, and provide information or assistance to the best of your abilities.

# OpenAI Configuration
OPENAI_MODEL_ID=o3-mini
OPENAI_TEMP=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_TOP_P=1.0
OPENAI_TOP_K=40
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0
OPENAI_API_BASE=
OPENAI_ORG_ID=
OPENAI_API_VERSION=2023-05-15

# Gemini Configuration
GEMINI_MODEL_ID=models/gemini-1.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=2048
GEMINI_TOP_P=0.8
GEMINI_TOP_K=40
GEMINI_API_BASE=
GEMINI_API_VERSION=

# Claude/Anthropic Configuration
CLAUDE_MODEL_ID=claude-3-haiku-20240307
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4000
CLAUDE_TOP_P=1.0
ANTHROPIC_API_BASE=
ANTHROPIC_API_VERSION=

# Agent Prompts
BASE_GENERATION_SYSTEM_PROMPT=Your task is to Generate the best content possible for the user's request. If the user provides critique, respond with a revised version of your previous attempt. You must always output the revised content.
BASE_REFLECTION_SYSTEM_PROMPT=You are tasked with generating critique and recommendations to the user's generated content. If the user content has something wrong or something to be improved, output a list of recommendations and critiques. If the user content is ok and there's nothing to change, output this: <OK> Utilize available tools if necessary to improve or validate the content.
PLANNING_INITIAL_PROMPT=You are a planning assistant with access to specific tools. Create a focused plan using ONLY the tools listed below.
PLANNING_REFLECTION_PROMPT=Reflect on the current execution state and determine if the plan needs adjustment.
CLASSIFY_PROMPT=You are AgentMatcher, an intelligent assistant designed to analyze user queries and match them with the most suitable agent or department.

# Agent Configuration
SAVE_CHAT=True
VERBOSE_LOGGING=False
MAX_RETRIES=3
TIMEOUT_SECONDS=60

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_RELOAD=True

# UI Configuration
UI_PORT=8501
UI_ADDRESS=0.0.0.0
UI_THEME=light

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s - [%(relpathname)s %(funcName)s(%(lineno)d)] - %(message)s
LOG_TO_FILE=True
LOG_DIR=logs